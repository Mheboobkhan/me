---
import { url, formatDate, readingTime, type Post } from '../utils';

interface Props {
  posts: Post[];
  /** Show the one-line description under each title. */
  descriptions?: boolean;
  /** Number entries as parts of a series. */
  numbered?: boolean;
}
const { posts, descriptions = true, numbered = false } = Astro.props;
---
<ol class="posts">
  {posts.map((post, i) => (
    <li>
      <span class="mono date">{numbered && <span class="part">{String(i + 1).padStart(2, '0')}</span>}{formatDate(post.data.pubDate)}</span>
      <div>
        <p><a class="title link-u" href={url(`/blog/${post.id}/`)}>{post.data.title}</a> <span class="mono len">{readingTime(post.body)} min</span></p>
        {descriptions && post.data.description && <p class="note">{post.data.description}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  li { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 16px; align-items: baseline; }
  .date { font-size: 11.5px; color: var(--muted); white-space: nowrap; }
  .part { color: var(--accent); margin-right: 8px; }
  .title { font-weight: 600; }
  .title:hover { color: var(--accent); }
  .len { font-size: 11px; color: var(--muted); margin-left: 6px; white-space: nowrap; }
  .note { font-size: 14px; color: var(--ink-soft); line-height: 1.5; margin-top: 2px; }
  @media (max-width: 520px) { li { grid-template-columns: 1fr; gap: 2px; } }
</style>
