---
// Conway's Game of Life. Move the pointer over the parent element to seed cells.
interface Props {
  /** Fill a bordered box instead of fading out as a page background. */
  framed?: boolean;
  /** Cell size in CSS pixels. */
  cell?: number;
}
const { framed = false, cell = 12 } = Astro.props;
---
<canvas class:list={['life', { framed }]} data-cell={cell} aria-hidden="true"></canvas>

<script>
  import { mountCanvas, cssVar, hexToRgb } from '../scripts/canvas';

  const STEP_MS = 120;

  document.querySelectorAll<HTMLCanvasElement>('canvas.life').forEach((canvas) => {
    const CELL = Number(canvas.dataset.cell) || 12;
    let cols = 0;
    let rows = 0;
    let grid = new Uint8Array(0);
    let next = new Uint8Array(0);
    let age = new Uint16Array(0); // generations alive
    let ghost = new Float32Array(0); // fading trail after death
    let clock = 0;
    let stale = 0;
    let lastPop = 0;

    const idx = (x: number, y: number) => ((y + rows) % rows) * cols + ((x + cols) % cols);

    const stamp = (cx: number, cy: number, pattern: number[][]) =>
      pattern.forEach(([dx, dy]) => (grid[idx(cx + dx, cy + dy)] = 1));

    const GLIDER = [[1, 0], [2, 1], [0, 2], [1, 2], [2, 2]];
    const LWSS = [[1, 0], [4, 0], [0, 1], [0, 2], [4, 2], [0, 3], [1, 3], [2, 3], [3, 3]];
    const RPENT = [[1, 0], [2, 0], [0, 1], [1, 1], [1, 2]];

    const seed = () => {
      for (let i = 0; i < grid.length; i++) grid[i] = Math.random() < 0.16 ? 1 : 0;
      for (let i = 0; i < 4; i++) stamp(Math.random() * cols | 0, Math.random() * rows | 0, GLIDER);
      stamp(cols * 0.7 | 0, rows * 0.3 | 0, RPENT);
      age.fill(0);
    };

    const sprinkle = () => {
      const p = [GLIDER, LWSS, RPENT][Math.random() * 3 | 0];
      stamp(Math.random() * cols | 0, Math.random() * rows | 0, p);
    };

    const step = () => {
      let pop = 0;
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const n =
            grid[idx(x - 1, y - 1)] + grid[idx(x, y - 1)] + grid[idx(x + 1, y - 1)] +
            grid[idx(x - 1, y)] + grid[idx(x + 1, y)] +
            grid[idx(x - 1, y + 1)] + grid[idx(x, y + 1)] + grid[idx(x + 1, y + 1)];
          const i = y * cols + x;
          const alive = grid[i] ? n === 2 || n === 3 : n === 3;
          next[i] = alive ? 1 : 0;
          if (alive) { age[i] = grid[i] ? Math.min(age[i] + 1, 999) : 0; pop++; }
          else if (grid[i]) ghost[i] = 1;
        }
      }
      [grid, next] = [next, grid];

      // Keep it lively: reseed small patterns when the board settles into still life.
      stale = Math.abs(pop - lastPop) <= 2 ? stale + 1 : 0;
      lastPop = pop;
      if (pop < grid.length * 0.02 || stale > 30) { sprinkle(); sprinkle(); stale = 0; }
    };

    mountCanvas(canvas, {
      fps: 30,
      stillFrames: 40,
      resize: ({ w, h }) => {
        const c = Math.ceil(w / CELL);
        const r = Math.ceil(h / CELL);
        if (c === cols && r === rows) return;
        cols = c; rows = r;
        grid = new Uint8Array(c * r);
        next = new Uint8Array(c * r);
        age = new Uint16Array(c * r);
        ghost = new Float32Array(c * r);
        seed();
      },
      frame: ({ ctx, w, h, dt }) => {
        clock += dt * 1000;
        while (clock >= STEP_MS) { step(); clock -= STEP_MS; }

        const [ar, ag, ab] = hexToRgb(cssVar('--accent'));
        const [ir, ig, ib] = hexToRgb(cssVar('--ink'));
        ctx.clearRect(0, 0, w, h);
        const s = CELL - 3;
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const i = y * cols + x;
            const px = x * CELL + 1.5;
            const py = y * CELL + 1.5;
            if (grid[i]) {
              // Newborns glow in the accent color, long-lived cells settle into ink.
              const k = Math.min(age[i] / 12, 1);
              const r = ar + (ir - ar) * k, g = ag + (ig - ag) * k, b = ab + (ib - ab) * k;
              ctx.fillStyle = `rgba(${r | 0},${g | 0},${b | 0},${0.45 - k * 0.3})`;
              ctx.fillRect(px, py, s, s);
            } else if (ghost[i] > 0.02) {
              ctx.strokeStyle = `rgba(${ar},${ag},${ab},${ghost[i] * 0.35})`;
              ctx.strokeRect(px + 0.5, py + 0.5, s - 1, s - 1);
              ghost[i] *= 0.9;
            }
          }
        }
      },
    });

    // Paint cells under the pointer (listen on the parent — the canvas ignores pointer events).
    const host = canvas.parentElement!;
    host.addEventListener('pointermove', (e) => {
      if (!cols) return;
      const r = canvas.getBoundingClientRect();
      const x = Math.floor((e.clientX - r.left) / CELL);
      const y = Math.floor((e.clientY - r.top) / CELL);
      if (x < 0 || y < 0 || x >= cols || y >= rows) return;
      for (let i = 0; i < 3; i++) grid[idx(x + (Math.random() * 3 - 1 | 0), y + (Math.random() * 3 - 1 | 0))] = 1;
    });
  });
</script>

<style>
  .life {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent 25%, rgba(0, 0, 0, 0.18) 45%, #000 78%);
    mask-image: linear-gradient(to right, transparent 25%, rgba(0, 0, 0, 0.18) 45%, #000 78%);
  }
  .life.framed { -webkit-mask-image: none; mask-image: none; }
  @media (max-width: 900px) {
    .life:not(.framed) {
      -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.2), #000 60%, transparent);
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.2), #000 60%, transparent);
    }
  }
</style>
