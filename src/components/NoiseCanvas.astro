---
// Gaussian noise field: per-pixel N(0,1) grain plus a few drifting Gaussian
// blobs, thresholded into a dithered pixel texture.
---
<canvas class="noise" aria-hidden="true"></canvas>

<script>
  import { mountCanvas, cssVar, hexToRgb, gaussian } from '../scripts/canvas';

  const PX = 4; // CSS pixels per noise pixel
  const TABLE = new Float32Array(1 << 14).map(() => gaussian());

  document.querySelectorAll<HTMLCanvasElement>('canvas.noise').forEach((canvas) => {
    const buf = document.createElement('canvas');
    const bctx = buf.getContext('2d')!;
    let img: ImageData | null = null;

    const blobs = Array.from({ length: 4 }, (_, i) => ({
      fx: 0.05 + Math.random() * 0.08,
      fy: 0.04 + Math.random() * 0.07,
      phase: Math.random() * Math.PI * 2,
      s: 0.045 + i * 0.018,
    }));

    mountCanvas(canvas, {
      fps: 20,
      stillFrames: 1,
      resize: ({ w, h }) => {
        buf.width = Math.ceil(w / PX);
        buf.height = Math.ceil(h / PX);
        img = bctx.createImageData(buf.width, buf.height);
      },
      frame: ({ ctx, w, h, t }) => {
        if (!img) return;
        const [r, g, b] = hexToRgb(cssVar('--accent'));
        const cw = buf.width;
        const ch = buf.height;
        const d = img.data;

        // Blob centers wander on slow Lissajous paths, biased toward the right side.
        const centers = blobs.map((bl, i) => {
          const s = bl.s * Math.max(cw, ch);
          return {
            x: cw * (0.66 + 0.32 * Math.sin(t * bl.fx * 6 + bl.phase + i)),
            y: ch * (0.5 + 0.45 * Math.cos(t * bl.fy * 6 + bl.phase * 1.3)),
            inv: 1 / (2 * s * s),
          };
        });

        let k = (Math.random() * TABLE.length) | 0;
        for (let y = 0; y < ch; y++) {
          for (let x = 0; x < cw; x++) {
            let f = 0;
            for (const c of centers) {
              const dx = x - c.x, dy = y - c.y;
              f += Math.exp(-(dx * dx + dy * dy) * c.inv);
            }
            const v = f * 0.75 + TABLE[k++ & (TABLE.length - 1)] * 0.22;
            const a = v > 0.85 ? 170 : v > 0.58 ? 80 : v > 0.4 ? 28 : 0;
            const o = (y * cw + x) * 4;
            d[o] = r; d[o + 1] = g; d[o + 2] = b; d[o + 3] = a;
          }
        }
        bctx.putImageData(img, 0, 0);
        ctx.clearRect(0, 0, w, h);
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(buf, 0, 0, cw * PX, ch * PX);
      },
    });
  });
</script>

<style>
  .noise {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent 20%, #000 75%);
    mask-image: linear-gradient(to right, transparent 20%, #000 75%);
  }
</style>
