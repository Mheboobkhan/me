---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { url, getFolders } from '../../../utils';

export async function getStaticPaths() {
  const folders = await getFolders();
  return folders.map(({ folder, posts }) => ({ params: { folder: folder.slug }, props: { folder, posts } }));
}

const { folder, posts } = Astro.props;
---
<Base title={folder.title} description={folder.description}>
  <div class="wrap page">
    <header class="head">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a class="link-u" href={url('/blog/')}>writing</a> / <span>{folder.slug}</span>
      </nav>
      <h1>{folder.title} {folder.short && <span class="chip keep-case">{folder.short}</span>}</h1>
      <p>{folder.description}</p>
      <p class="mono count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </header>
    {posts.length ? <PostList posts={posts} numbered={folder.series} /> : <p class="mono empty">∵ first post coming soon.</p>}
  </div>
</Base>

<style>
  .page { max-width: 860px; padding-top: 40px; padding-bottom: 40px; }
  .head { display: grid; gap: 10px; padding-bottom: 24px; margin-bottom: 28px; border-bottom: 1px dashed var(--line-strong); }
  .crumbs { font-size: 12px; color: var(--muted); }
  h1 { font-size: clamp(28px, 4.5vw, 40px); letter-spacing: -0.01em; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  h1 .chip { font-size: 12px; }
  .head > p { color: var(--ink-soft); font-size: 15px; max-width: 680px; }
  .count { font-size: 12px; color: var(--muted) !important; }
  .empty { font-size: 12px; color: var(--muted); }
</style>
