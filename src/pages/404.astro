---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
---
<Base title="Not found">
  <section>
    <div class="wrap nf">
      <span class="mono tag">[404]</span>
      <h1>This decision returned <span>null</span>.</h1>
      <p class="mono">confidence: 0.00 — the page you're looking for doesn't exist.</p>
      <a class="btn btn-dark" href={url('/')}>Back home <span class="arrow">→</span></a>
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 24px; justify-items: start; min-height: 55vh; align-content: center; }
  .tag { color: var(--accent); font-size: 13px; }
  h1 { font-size: clamp(40px, 7vw, 80px); letter-spacing: -0.01em; }
  h1 span { color: var(--accent); font-family: var(--font-mono); font-weight: 400; letter-spacing: -0.01em; }
  p { color: var(--muted); font-size: 13px; }
</style>
